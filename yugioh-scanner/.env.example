# Fonction de prix (Netlify). Toutes ces variables sont facultatives.

# Interroger Cardmarket avant de retomber sur YGOPRODeck.
# « false » pour n'utiliser que YGOPRODeck.
CARDMARKET_SCRAPE=true

# Délai au-delà duquel on abandonne Cardmarket et on passe au repli.
CARDMARKET_TIMEOUT_MS=4000

# Chemin de base du site : « / » sur Netlify, « /<nom-du-depot>/ » sur GitHub Pages.
VITE_BASE=/

# Ressources Tesseract. Vides, elles pointent vers le CDN par défaut.
# À renseigner pour servir le moteur depuis votre propre domaine.
# VITE_TESSERACT_WORKER_PATH=
# VITE_TESSERACT_CORE_PATH=
# VITE_TESSERACT_LANG_PATH=
