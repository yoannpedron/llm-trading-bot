node_modules/
dist/
.netlify/
.env
.env.local
*.local

# Index de cartes : régénéré au build depuis YGOPRODeck (voir scripts/build-index.mjs)
public/card-index.json

# Le moteur de lecture (public/modeles/) est versionné : l'application doit
# lire sans dépendre d'un CDN tiers. Voir src/lib/modeles.js.

# Base SQLite du backend, reconstruite par `python -m app.cli sync`
backend/data/
__pycache__/
*.pyc
.pytest_cache/

# La règle « *.txt » du .gitignore racine avalait ce fichier, que README et
# passation demandent pourtant d’installer.
!backend/requirements.txt
!public/modeles/*.txt
