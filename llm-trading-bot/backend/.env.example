# ─────────────────────────────────────────────────────────────
#  LLM Trading Bot — configuration back-end
#  Copie ce fichier en `.env` et remplis les valeurs.
#  NE JAMAIS committer le fichier .env.
# ─────────────────────────────────────────────────────────────

# --- Serveur ---
PORT=8080
# Origines autorisées pour le dashboard (séparées par des virgules, * = tout)
CORS_ORIGINS=*
# Jeton protégeant les routes d'écriture (/api/cycle, /api/reset, /api/control)
ADMIN_TOKEN=change-moi-avec-une-longue-chaine-aleatoire

# --- Cerveau LLM ---
LLM_PROVIDER=gemini            # gemini | heuristic (fallback sans clé)

# Plusieurs comptes Google gratuits = plusieurs quotas cumulés.
# Liste séparée par des virgules ; le bot passe automatiquement à la clé
# suivante quand la précédente atteint son quota du jour.
# Tu peux aussi en ajouter à chaud, sans redémarrer : npm run keys:add -- <clé>
GEMINI_API_KEYS=
GEMINI_API_KEY=                # accepté seul, pour rétrocompatibilité
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
# 0 = pas de raisonnement interne (rapide/économe). 512-1024 = décisions plus fines.
LLM_THINKING_BUDGET=0
# Pause entre deux actifs d'un même cycle : évite les HTTP 429 du palier gratuit.
LLM_COOLDOWN_MS=8000
# Plafond d'appels par jour ET PAR CLÉ. Le palier GRATUIT de gemini-2.5-flash
# est à 20 requêtes/jour et par projet Google. 0 = illimité (clé payante).
# Capacité totale = (nombre de clés) × cette valeur.
# Règle : (nb de SYMBOLS) × (cycles par jour) <= capacité totale.
# `npm run keys` affiche la capacité et le CRON_SCHEDULE conseillé.
LLM_CALLS_PER_KEY_PER_DAY=20

# --- Univers & horaire ---
SYMBOLS=TSLA,AAPL,MSFT         # tickers Yahoo Finance (EURUSD=X, BTC-USD... acceptés)
CANDLE_INTERVAL=1h             # 15m | 30m | 1h | 1d
CANDLE_RANGE=3mo               # profondeur d'historique récupérée
# Toutes les 4 h = 6 cycles/jour × 3 actifs = 18 appels LLM : compatible palier gratuit.
# Avec une clé payante, `*/30 * * * *` (toutes les 30 min) est un bon réglage.
CRON_SCHEDULE=0 */4 * * *
CRON_TIMEZONE=Europe/Paris
RUN_ON_START=true              # lance un cycle au démarrage
ONLY_MARKET_HOURS=true         # ignore les actions US hors séance (crypto/FX non concernés)

# --- Capital & risque ---
BASE_CURRENCY=EUR
INITIAL_CAPITAL=100
MAX_POSITIONS=3                # nb max de positions simultanées
MAX_POSITION_PCT=0.35          # 35 % de l'équity max par position
MIN_ORDER_VALUE=5              # ordre ignoré en dessous (en devise de compte)
STOP_LOSS_PCT=0.05             # stop -5 %
TAKE_PROFIT_PCT=0.12           # objectif +12 %
MAX_DAILY_LOSS_PCT=0.10        # coupe-circuit : -10 % sur la journée
FEE_PCT=0.001                  # frais simulés 0,1 %
SLIPPAGE_PCT=0.0005            # slippage simulé 0,05 %

# --- Broker ---
BROKER=paper                   # paper | alpaca (alpaca = squelette, non activé)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Actualités (tous optionnels : fallback RSS sans clé) ---
NEWS_PROVIDERS=finnhub,newsapi,rss   # ordre d'essai, bascule automatique
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_ARTICLES=8
FINNHUB_API_KEY=
NEWSAPI_KEY=

# --- Stockage ---
DATA_DIR=./data
