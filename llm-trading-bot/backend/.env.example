# ─────────────────────────────────────────────────────────────
#  LLM Trading Bot — configuration back-end
#  Copie ce fichier en `.env` et remplis les valeurs.
#  NE JAMAIS committer le fichier .env.
# ─────────────────────────────────────────────────────────────

# --- Serveur ---
PORT=8080
# Origines autorisées pour le dashboard (séparées par des virgules, * = tout)
CORS_ORIGINS=*
# Jeton protégeant les routes d'écriture (/api/cycle, /api/reset, /api/control)
ADMIN_TOKEN=change-moi-avec-une-longue-chaine-aleatoire

# --- Cerveau LLM ---
LLM_PROVIDER=gemini            # gemini | heuristic (fallback sans clé)

# Plusieurs comptes Google gratuits = plusieurs quotas cumulés.
# Liste séparée par des virgules ; le bot passe automatiquement à la clé
# suivante quand la précédente atteint son quota du jour.
# Tu peux aussi en ajouter à chaud, sans redémarrer : npm run keys:add -- <clé>
GEMINI_API_KEYS=
GEMINI_API_KEY=                # accepté seul, pour rétrocompatibilité
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
# Laisser cette ligne ABSENTE (pas à 0) : config.js choisit alors 128 pour les
# modèles Gemini 3.x et 0 pour les autres. Gemini 3.x REFUSE thinkingBudget=0
# avec un HTTP 400 « invalid argument » — si cette ligne est décommentée avec
# 0, elle écrase ce choix automatique et casse tout appel sur un modèle 3.x.
# Bug vécu en déploiement : .env.example forçait 0, invisible en local car la
# ligne y avait été retirée, mais copiée telle quelle sur le serveur.
# LLM_THINKING_BUDGET=128
# Pause entre deux actifs d'un même cycle : évite les HTTP 429 du palier gratuit.
LLM_COOLDOWN_MS=8000
# Plafond d'appels par jour ET PAR CLÉ. Le palier GRATUIT de gemini-2.5-flash
# est à 20 requêtes/jour et par projet Google. 0 = illimité (clé payante).
# Capacité totale = (nombre de clés) × cette valeur.
# Règle : (nb de SYMBOLS) × (cycles par jour) <= capacité totale.
# `npm run keys` affiche la capacité et le CRON_SCHEDULE conseillé.
LLM_CALLS_PER_KEY_PER_DAY=20

# --- Univers & horaire ---
SYMBOLS=                       # vide = univers de 150 valeurs par défaut (src/data/universe.js).
                               # Une liste explicite le remplace. Vérifie la couverture
                               # d'anonymisation avec `npm run entities` après tout changement.
CANDLE_INTERVAL=1h             # 15m | 30m | 1h | 1d
CANDLE_RANGE=3mo               # profondeur d'historique récupérée
# Toutes les 4 h = 6 cycles/jour × 3 actifs = 18 appels LLM : compatible palier gratuit.
# Avec une clé payante, `*/30 * * * *` (toutes les 30 min) est un bon réglage.
CRON_SCHEDULE=0 */4 * * *
CRON_TIMEZONE=Europe/Paris
RUN_ON_START=true              # lance un cycle au démarrage
ONLY_MARKET_HOURS=true         # ignore les actions US hors séance (crypto/FX non concernés)

# --- Capital & risque ---
BASE_CURRENCY=USD              # le compte Alpaca est en dollars : aucune conversion
INITIAL_CAPITAL=100
MAX_POSITIONS=3                # nb max de positions simultanées
MAX_POSITION_PCT=0.35          # 35 % de l'équity max par position
MIN_ORDER_VALUE=5              # Alpaca ne prend aucune commission fixe : plancher bas

# Stops dimensionnés sur la volatilité, pas sur un pourcentage arbitraire.
# Un stop à 5 % est SOUS le bruit journalier de TSLA (ATR 3-5 %) et coupe des
# positions gagnantes au hasard.
STOP_ATR_MULTIPLE=4            # distance = 4 × ATR(14)
STOP_MIN_PCT=0.08              # plancher
STOP_MAX_PCT=0.2               # plafond
TAKE_PROFIT_PCT=0              # 0 = désactivé : un TP fixe tronque la queue droite

# Coupe-circuit MENSUEL. En journalier, 10 % de 100 $ = 10 $, soit dans le bruit
# normal d'un portefeuille de valeurs volatiles — le seuil se déclenchait à tort.
MAX_MONTHLY_LOSS_PCT=0.15

# Seuils appliqués à la prévision du modèle. Il annonce une répartition sur 100
# scénarios ; c'est ICI qu'on décide d'agir, pas dans le prompt.
MIN_EDGE=0.2                   # écart minimal surperf/sousperf (60/40, pas 51/49)
MIN_UP_PROBABILITY=0.4         # et probabilité haussière absolue suffisante

FEE_PCT=0                      # Alpaca : zéro commission
SLIPPAGE_PCT=0                 # mesuré réellement, pas simulé (voir /api/execution)

# --- Broker ---
BROKER=alpaca                  # alpaca (compte paper réel) | paper (simulateur hors ligne)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex           # iex (gratuit) | sip (abonnement payant)

# --- Actualités (tous optionnels : fallback RSS sans clé) ---
NEWS_PROVIDERS=finnhub,newsapi,rss   # ordre d'essai, bascule automatique
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_ARTICLES=8
FINNHUB_API_KEY=
NEWSAPI_KEY=

# --- Stockage ---
DATA_DIR=./data
