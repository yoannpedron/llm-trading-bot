[Unit]
Description=LLM Trading Bot — moteur de decision et API
Documentation=https://github.com/
# Le bot appelle Alpaca et Gemini des le demarrage : attendre que le reseau soit
# reellement utilisable, pas seulement configure.
After=network-online.target
Wants=network-online.target

# Empeche une boucle de redemarrage de saturer la machine si la configuration
# est fausse (cle Alpaca invalide, par exemple) : au-dela de 5 echecs en
# 5 minutes, systemd s'arrete et laisse l'erreur visible dans le journal.
# Ces deux cles appartiennent a [Unit], pas [Service] — systemd les ignore
# silencieusement (avec un avertissement) si elles sont mises au mauvais endroit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=botuser
Group=botuser

# `dotenv` lit le .env depuis le repertoire courant : WorkingDirectory doit donc
# pointer sur backend/, sinon les secrets ne sont jamais charges et le bot
# demarre en croyant n'avoir aucune cle.
WorkingDirectory=/opt/llm-trading-bot/src/llm-trading-bot/backend
ExecStart=/usr/bin/node src/server.js

# DATA_DIR est force en absolu, hors du depot. Sans cela, un `git clean` ou un
# redeploiement effacerait le carnet fantome — c'est-a-dire la totalite de la
# mesure, en silence.
Environment=DATA_DIR=/opt/llm-trading-bot/backend/data
Environment=NODE_ENV=production

# Redemarrage systematique. Le bot doit etre vivant a 16h30, 19h30 et 21h30
# heure de Paris : chaque cycle manque est de la donnee definitivement perdue.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-bot

# ── Durcissement ────────────────────────────────────────────────────────────
# Le bot detient des cles d'API de courtage : on limite ce qu'un processus
# compromis pourrait atteindre.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Seul le dossier de donnees est accessible en ecriture.
ReadWritePaths=/opt/llm-trading-bot/backend/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# PAS de MemoryDenyWriteExecute : Node.js compile du JavaScript en code machine
# à la volée (JIT V8) et a besoin de pages mémoire écriture+exécution pour ça.
# Avec ce paramètre activé, le tout premier appel au compilateur JIT échoue —
# observé en production : `Check failed: 12 == (*__errno_location())` (ENOMEM
# sur mprotect), un plantage immédiat au démarrage, avant même que le port
# 8099 ne s'ouvre. Ce durcissement est fait pour des binaires statiques, pas
# pour un moteur JIT.
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
